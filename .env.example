# OBOiFY — Environment Configuration
# Data Provider: 'firebase' (Cloud mode) or 'local' (Offline-first LocalStorage)
VITE_DATA_PROVIDER=firebase

# Firebase Web App Credentials (from Firebase Console -> Project Settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Google Gemini AI Studio API Key (from https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Google Cloud OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
